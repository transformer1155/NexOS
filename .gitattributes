###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# NOTE (2026-11-13): Git LFS was removed from this repository.  The Gitee
# mirror rejects LFS object uploads ("LFS only supported repository in paid
# or trial enterprise"), so any LFS-tracked blob made `git push origin` fail
# before the ref update.  Virtual disk images and initrd tarballs are build
# artifacts and live outside git (see .gitignore) instead.

###############################################################################
# Behavior for binary formats -- no EOL conversion, no textual diff.
###############################################################################
*.bmp binary
*.ppm binary
*.ttf binary
*.gz binary
*.img binary
*.iso binary
*.vhd binary
*.vmdk binary
*.vdi binary
